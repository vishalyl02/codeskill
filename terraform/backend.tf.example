# =================================================================================================
# Remote S3 Backend Configuration Example
# To enable remote state storage with team locking:
# 1. Create an S3 bucket with versioning and encryption enabled
# 2. Create a DynamoDB table with partition key 'LockID' (String)
# 3. Rename this file to 'backend.tf' and run: terraform init -migrate-state
# =================================================================================================

# terraform {
#   backend "s3" {
#     bucket         = "codeskill-terraform-state-239939507154"
#     key            = "production/terraform.tfstate"
#     region         = "ap-south-1"
#     encrypt        = true
#     dynamodb_table = "codeskill-terraform-locks"
#   }
# }
