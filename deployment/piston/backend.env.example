# Set on both API and trusted judge workers; keep legacy during provisioning/canary.
CODE_EXECUTION_PROVIDER=legacy
PISTON_BASE_URL=http://piston.internal:2000/api/v2
PISTON_REQUEST_TIMEOUT_MS=15000
PISTON_MAX_CONCURRENT_EXECUTIONS=10
PISTON_DEFAULT_RUN_TIMEOUT_MS=3000
PISTON_DEFAULT_COMPILE_TIMEOUT_MS=10000
PISTON_DEFAULT_MEMORY_LIMIT_BYTES=268435456
PISTON_COMPILE_MEMORY_LIMIT_BYTES=536870912
PISTON_RUNTIME_CACHE_TTL_MS=60000
PISTON_OUTPUT_LIMIT_BYTES=65536
# Populate ONLY from reviewed provisioning output and successful smoke tests.
PISTON_RUNTIME_VERSIONS={}
WORKER_CONCURRENCY=10
SUBMISSION_RATE_LIMIT_PER_MINUTE=15
MAX_CONCURRENT_JOBS_PER_USER=2
# Worker only: PROCESS_ROLE=judge
