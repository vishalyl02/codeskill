# Append to backend-nestjs/.env on EVERY API and judge worker.
# Keep your database, submission-shard, authentication, and AI settings.
CODE_EXECUTION_PROVIDER=judge0
PROCESS_ROLE=api
ENABLE_EMBEDDED_JUDGE=false

# Primary: self-hosted Judge0 1.13.1 (X-Auth-Token from its judge0.conf).
JUDGE0_BASE_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=replace-with-generated-authn-token
JUDGE0_LANGUAGE_IDS={"c":50,"cpp":54,"java":62,"python":71,"javascript":63,"typescript":74}
JUDGE0_REQUEST_TIMEOUT_MS=5000
JUDGE0_SUBMISSION_TIMEOUT_MS=30000
JUDGE0_POLL_INTERVAL_MS=250
JUDGE0_MAX_RUN_TIMEOUT_MS=10000
JUDGE0_MAX_MEMORY_MB=512
JUDGE0_MAX_CONCURRENT_EXECUTIONS=2
JUDGE0_GLOBAL_MAX_CONCURRENT=2
JUDGE0_NODE_MAX_CONCURRENT=2
JUDGE0_CIRCUIT_FAILURE_THRESHOLD=3
JUDGE0_CIRCUIT_COOLDOWN_MS=15000
JUDGE_TEST_CASE_CONCURRENCY=2
JUDGE_OUTPUT_LIMIT_BYTES=65536
JUDGE_TIME_LIMIT_MULTIPLIER=1

# Secondary: self-hosted Piston. Copy versions from the verified registry report.
PISTON_BASE_URL=http://127.0.0.1:2001/api/v2
PISTON_RUNTIME_VERSIONS={}
PISTON_REQUEST_TIMEOUT_MS=15000
PISTON_DEFAULT_RUN_TIMEOUT_MS=3000
PISTON_DEFAULT_COMPILE_TIMEOUT_MS=10000
PISTON_MAX_CONCURRENT_EXECUTIONS=2
PISTON_GLOBAL_MAX_CONCURRENT=2
PISTON_NODE_MAX_CONCURRENT=2
PISTON_TEST_CASE_CONCURRENCY=2
PISTON_CIRCUIT_FAILURE_THRESHOLD=3
PISTON_CIRCUIT_COOLDOWN_MS=15000
PISTON_OUTPUT_LIMIT_BYTES=65536

# Run + Submit + coding assessment share a single atomic per-user allowance.
MAX_CONCURRENT_JOBS_PER_USER=1
SUBMISSION_RATE_LIMIT_PER_MINUTE=15
MAX_QUEUE_WAITING=500
EXECUTION_JOB_LEASE_MS=900000
EXECUTION_HEARTBEAT_MS=15000
WORKER_CONCURRENCY=2

# For multiple private hosts, replace the single URLs with JSON arrays.
# The caps below are examples for TWO endpoints with EIGHT slots each.
# JUDGE0_BASE_URLS=["http://judge0-a.internal:2358","http://judge0-b.internal:2358"]
# PISTON_BASE_URLS=["http://piston-a.internal:2000/api/v2","http://piston-b.internal:2000/api/v2"]
# JUDGE0_GLOBAL_MAX_CONCURRENT=16
# JUDGE0_NODE_MAX_CONCURRENT=8
# PISTON_GLOBAL_MAX_CONCURRENT=16
# PISTON_NODE_MAX_CONCURRENT=8
# JUDGE0_MAX_CONCURRENT_EXECUTIONS=8
# PISTON_MAX_CONCURRENT_EXECUTIONS=8

# Optional hosted Judge0 RapidAPI authentication; leave unset for local Docker.
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
# Optional Piston gateway authentication implemented by your private gateway.
# PISTON_API_KEY=
