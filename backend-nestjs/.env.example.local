PORT=5001
# PostgreSQL / AWS RDS Database
DATABASE_URL=postgres://postgres:password123@127.0.0.1:5432/codeskill
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=codeskill
DATABASE_SSL=false
JWT_SECRET=supersecretcodeskilljwt
JWT_EXPIRE=30d

# Redis Configuration (Make sure Redis is running locally)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# OAuth Configurations
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# AWS SES Configuration (For OTP Emails)
AWS_REGION=ap-south-1
AWS_SES_EMAIL=samtipu20016@gmail.com
# Set these to your real keys for local development
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Sandbox / Compilation Configuration
# (Can be left as default for local dev)
SANDBOX_TIMEOUT=10000
SANDBOX_MEMORY_LIMIT=256

# Frontend URL (For CORS and email links)
CLIENT_URL=http://localhost:3000

# Practice pet: use a free OpenRouter coding model for open-ended answers.
# Voice input falls back to on-device Whisper; spoken replies use browser speech synthesis.
# Without an AI key, the pet offers one hint using each problem's public input and examples.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

# Optional direct DeepSeek fallback when OpenRouter is not configured.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional submission sharding; see docs/submission-sharding.md.
# Configure every API and judge identically after the offline migration.
SUBMISSION_SHARDS=
SUBMISSION_SHARD_POOL_SIZE=5
