PORT=5001
NODE_ENV=production

# Database Configuration (AWS RDS / PostgreSQL)
DATABASE_URL=postgresql://postgres:password123@localhost:5432/codeskill
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=codeskill
DATABASE_SSL=false

# JWT Authentication
JWT_SECRET=supersecretcodeskilljwt
JWT_EXPIRE=30d

# Admin Accounts & Credentials
ADMIN_EMAILS=admin@codeskill.com,admin@cuchd.in,md.shadab.azam.ansari@gmail.com,kanhamishra555@gmail.com,shaikhmustakim2942@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_CUCHD_PASSWORD=Admin@CodeSkill2026

# Redis Configuration (Assuming Redis running on host: 127.0.0.1:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# OAuth Configurations
GOOGLE_CLIENT_ID=968191151730-mglf3rq4pldoqqhhcrbqfbt9g2j9n8o6.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# AWS SES & S3 Configuration (For OTP Emails & S3 Uploads)
AWS_REGION=ap-south-1
AWS_SES_EMAIL=noreply@codeskill.novaserve.cloud
AWS_SES_SENDER=noreply@codeskill.novaserve.cloud
# If an IAM Role is attached to EC2, leave access keys blank (the SDK auto-fetches instance profile credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=codeskill-prod-files-reports

# Sandbox / Code Execution Configuration
SANDBOX_TIMEOUT=10000
SANDBOX_MEMORY_LIMIT=256

# Frontend URL (For CORS & email links)
# Replace with your EC2 Public IP or domain name (e.g. https://codeskill.evolvian.in or http://YOUR_EC2_IP:3000)
CLIENT_URL=https://codeskill.novaserve.cloud

# Optional submission sharding; see docs/submission-sharding.md.
# Configure every API and judge identically after the offline migration.
SUBMISSION_SHARDS=
SUBMISSION_SHARD_POOL_SIZE=5
